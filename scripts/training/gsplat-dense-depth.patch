+    def _load_dense_depth(self, item: int, height: int, width: int) -> np.ndarray:
+        """Load a dense depth map and warp it exactly like the image.
+
+        The file is `<depth_dir>/<image name without extension>.npy`: camera z-depth
+        in COLMAP model units, any resolution with the image's aspect ratio, 0 where
+        there is no measurement.
+        """
+        index = self.indices[item]
+        stem = os.path.splitext(self.parser.image_names[index])[0]
+        depth = np.load(os.path.join(self.depth_dir, stem + ".npy")).astype(np.float32)
+        camera_id = self.parser.camera_ids[index]
+        # Nearest-neighbour throughout, so depths never blend across object edges.
+        if len(self.parser.params_dict[camera_id]) > 0:
+            mapx, mapy = (
+                self.parser.mapx_dict[camera_id],
+                self.parser.mapy_dict[camera_id],
+            )
+            size = (mapx.shape[1], mapx.shape[0])
+            depth = cv2.resize(depth, size, interpolation=cv2.INTER_NEAREST)
+            depth = cv2.remap(depth, mapx, mapy, cv2.INTER_NEAREST)
+            x, y, w, h = self.parser.roi_undist_dict[camera_id]
+            depth = depth[y : y + h, x : x + w]
+        else:
+            depth = cv2.resize(depth, (width, height), interpolation=cv2.INTER_NEAREST)
+        assert depth.shape == (height, width), (depth.shape, (height, width))
+        # The world normalization is a uniform scale, so z-depth scales with it.
+        return depth * np.linalg.norm(self.parser.transform[:3, 0])
+
